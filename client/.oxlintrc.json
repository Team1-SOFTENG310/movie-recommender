{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "oxc", "vitest"],
  "options": {
    // Type-aware rules (no-unsafe-*, no-floating-promises, ...) run through
    // oxlint-tsgolint, which uses the same TypeScript 7 as `tsc`.
    "typeAware": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // Existing effects reset state when their inputs change. Kept as a
    // warning until those components are refactored.
    "react/set-state-in-effect": "warn",

    // `strict` lets `any` in through response.json(), JSON.parse() and
    // untyped mocks without an error; these rules catch it where it is used.
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",

    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error"
  },
  "ignorePatterns": ["dist/**"]
}
